{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAI Style Lab",
  "version": "4.0.0",
  "identifier": "net.yeol.nai-style-lab",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "../web/icon-512.png"
    ],
    "resources": {
      "../app/*.py": "app/",
      "../web/": "web/"
    },
    "linux": {
      "deb": {
        "depends": [
          "python3",
          "python3-pil",
          "xdg-utils"
        ]
      }
    }
  }
}
